+++ b/smali/com/samsung/android/motionphoto/utils/v2/video/transition/renderer/TransitionEncoder.smali	2026-11-24 15:59:38.022912105 +0100
@@ -139,7 +139,7 @@
 
     const-string v1, "color-format"
 
-    const v2, 0x7f420888
+    const v2, 0x7f000789
 
     invoke-virtual {v0, v1, v2}, Landroid/media/MediaFormat;->setInteger(Ljava/lang/String;I)V
 
diff -ruN a/smali/com/samsung/android/sum/core/filter/EncoderFilter.smali b/smali/com/samsung/android/sum/core/filter/EncoderFilter.smali
--- a/smali/com/samsung/android/sum/core/filter/EncoderFilter.smali	2026-11-24 15:59:37.623417307 +0100
+++ b/smali/com/samsung/android/sum/core/filter/EncoderFilter.smali	2026-11-24 15:59:38.022442034 +0100
@@ -1935,7 +1935,7 @@
     invoke-virtual {v2, v5, v4}, Landroid/media/MediaFormat;->setInteger(Ljava/lang/String;I)V
 
     :cond_12
-    const v4, 0x7f420888
+    const v4, 0x7f000789
 
     invoke-static {v4}, Ljava/lang/Integer;->valueOf(I)Ljava/lang/Integer;
 
