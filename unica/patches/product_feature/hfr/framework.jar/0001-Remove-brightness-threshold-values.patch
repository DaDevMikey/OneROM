From 91cf366ab58c46c90b19029beb94463bd817ce65 Mon Sep 17 00:00:00 2001
From: ExtremeXT <75576145+ExtremeXT@users.noreply.github.com>
Date: Fri, 12 Sep 2025 23:46:04 +0200
Subject: [PATCH] Remove brightness threshold values

Signed-off-by: dupazlasu <dupazlasu66@gmail.com>
---
 smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali | 10 ++++------
 1 file changed, 4 insertions(+), 6 deletions(-)

diff --git a/smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali b/smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali
index f3b7067..e054354 100644
--- a/smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali
+++ b/smali_classes6/com/samsung/android/hardware/display/RefreshRateConfig.smali
@@ -265,7 +265,7 @@
 
     if-eqz p2, :cond_3
 
-    const-string v2, "89,91"
+    const-string v2, ""
 
     goto :goto_2
 
@@ -293,7 +293,7 @@
 
     if-eqz p2, :cond_4
 
-    const-string v1, "260,2500"
+    const-string v1, ""
 
     :cond_4
     invoke-virtual {v0, v1}, Ljava/lang/StringBuilder;->append(Ljava/lang/String;)Ljava/lang/StringBuilder;
@@ -498,11 +498,9 @@
 
     const-string/jumbo v2, "persist.dm.passive.ambient_brightness"
 
-    const-string v3, "89,91"
-
-    const-string v4, "260,2500"
+    const-string v3, ""
 
-    invoke-direct {v0, v3, v4, v1, v2}, Lcom/samsung/android/hardware/display/RefreshRateConfig$BrightnessThreshold;-><init>(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V
+    invoke-direct {v0, v3, v3, v1, v2}, Lcom/samsung/android/hardware/display/RefreshRateConfig$BrightnessThreshold;-><init>(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V
 
     const-string v1, "2"
 
